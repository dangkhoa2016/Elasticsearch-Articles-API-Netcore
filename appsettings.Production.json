{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DatabaseProvider": {
    "Provider": "PostgreSQL",
    "CommandTimeout": 60
  },
  "ConnectionStrings": {
    "DBConnectionString": "Host=localhost;Port=5432;Database=articles_api;Username=postgres;Password=CHANGE_ME_IN_PRODUCTION"
  },
  "Resilience": {
    "Retry": {
      "MaxRetries": 5,
      "DelayMs": 2000
    },
    "CircuitBreaker": {
      "FailureThreshold": 0.4,
      "MinimumThroughput": 5,
      "DurationOfBreakSeconds": 60
    },
    "Timeout": {
      "Seconds": 60
    }
  },
  "AllowedOrigins": [
    "https://yourdomain.com",
    "https://www.yourdomain.com"
  ],
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 500
      }
    ],
    "EndpointRules": [
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "1m",
        "Limit": 3
      },
      {
        "Endpoint": "POST:/api/auth/register",
        "Period": "1m",
        "Limit": 2
      }
    ]
  }
}
