{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "ConnectionStrings": {
    "DBConnectionString": "Data Source=:memory:"
  },
  "ElasticsearchSettings": {
    "url": "http://localhost:9200",
    "defaultIndex": "articles-test"
  },
  "AllowedOrigins": [
    "http://localhost:3000"
  ],
  "JwtSettings": {
    "Secret": "TestSuperSecretKeyThatIsAtLeast32CharsLong!",
    "Issuer": "ElasticsearchArticlesAPI-Test",
    "Audience": "ElasticsearchArticlesAPIUsers-Test",
    "ExpirationMinutes": 60
  },
  "CacheSettings": {
    "DefaultExpirationMinutes": 1,
    "ArticleExpirationMinutes": 1,
    "ArticleListExpirationMinutes": 1
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [],
    "EndpointRules": []
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  },
  "AllowedHosts": "*"
}
